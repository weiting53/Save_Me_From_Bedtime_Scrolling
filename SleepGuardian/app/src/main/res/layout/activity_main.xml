<?xml version="1.0" encoding="utf-8"?>
<!--
  純黑像素風格主畫面
  背景：#000000，所有元件：#FFFFFF，邊框：細白實線（無 anti-alias）
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- ── 頂端欄：App 標題 + ⚙ 按鈕 ── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="S L E E P  G U A R D I A N"
            android:textColor="#FFFFFF"
            android:textSize="8.5sp"
            android:fontFamily="monospace"
            android:alpha="0.45"/>

        <TextView
            android:id="@+id/tv_adb_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="&#9881;"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:alpha="0.6"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </RelativeLayout>

    <!-- ── 7-segment 睡覺時鐘（可點擊修改時間） ── -->
    <com.sleepguardian.SegmentClockView
        android:id="@+id/clock_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.0"
        android:paddingHorizontal="18dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <!-- ── MODE 標籤 ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="-  M O D E  -"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.28"/>

    <!-- ── 橫向滑動模式卡片 ── -->
    <HorizontalScrollView
        android:id="@+id/mode_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.6"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/mode_cards_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:clipChildren="false">

            <!-- Card 0: 組合包 -->
            <com.sleepguardian.GlowCardView
                android:id="@+id/card_0"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#9788;  &#9681;  &#8663;  &#8635;"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="10dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMBO PACK"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brightness + Grayscale\n+ Network + Refresh"
                        android:textColor="#888888"
                        android:textSize="8.5sp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>
            </com.sleepguardian.GlowCardView>

            <!-- Card 1: 亮度 + 灰階 -->
            <com.sleepguardian.GlowCardView
                android:id="@+id/card_1"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#9788;  &#9681;"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="10dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIM + GRAY"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brightness +\nGrayscale Only"
                        android:textColor="#888888"
                        android:textSize="8.5sp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>
            </com.sleepguardian.GlowCardView>

            <!-- Card 2: 僅降網速 -->
            <com.sleepguardian.GlowCardView
                android:id="@+id/card_2"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8663;"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="10dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BANDWIDTH\nONLY"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="T+10 Network\nThrottle"
                        android:textColor="#888888"
                        android:textSize="8.5sp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>
            </com.sleepguardian.GlowCardView>

            <!-- Card 3: 僅降更新率 -->
            <com.sleepguardian.GlowCardView
                android:id="@+id/card_3"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8635;"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="10dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REFRESH\nRATE ONLY"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="T+10 Rate\nStep-Down"
                        android:textColor="#888888"
                        android:textSize="8.5sp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>
            </com.sleepguardian.GlowCardView>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ── 起床時間（可點擊修改） ── -->
    <LinearLayout
        android:id="@+id/time_wake_area"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WAKE TIME: "
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:fontFamily="monospace"/>
        <TextView
            android:id="@+id/tv_wake_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05:00"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  [&#9998;]"
            android:textColor="#555555"
            android:textSize="10sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- ── 睡眠插畫（兔兔與女孩 GIF） ── -->
    <ImageView
        android:id="@+id/iv_sleeping"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.2"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@null"/>

    <!-- ── 狀態列（精簡） ── -->
    <TextView
        android:id="@+id/tv_phase"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center"
        android:text="IDLE"
        android:textColor="#444444"
        android:textSize="8sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.22"/>

    <!-- tv_status: 隱藏（程式碼相容用，重要錯誤訊息透過 Toast 或 tv_phase 顯示） -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#555555"
        android:textSize="8sp"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingHorizontal="16dp"
        android:visibility="gone"/>

    <!-- ── 開始 / 停止按鈕 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="2dp">

        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:text="START"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:text="STOP"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:enabled="false"/>
    </LinearLayout>

    <!-- ── 每日自動開始 ── -->
    <Switch
        android:id="@+id/sw_daily_schedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="AUTO DAILY"
        android:textColor="#555555"
        android:textSize="8sp"
        android:fontFamily="monospace"
        android:thumbTint="#666666"
        android:trackTint="#222222"/>

    <!-- ── Demo 入口（低調） ── -->
    <TextView
        android:id="@+id/tv_demo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:padding="8dp"
        android:paddingBottom="14dp"
        android:text="demo"
        android:textColor="#333333"
        android:textSize="8sp"
        android:fontFamily="monospace"
        android:alpha="0.5"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <!-- 隱藏的相容 view（程式碼沿用） -->
    <TextView android:id="@+id/tv_sleep_time"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <View android:id="@+id/time_sleep_area"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <Button android:id="@+id/btn_mode_prev"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <Button android:id="@+id/btn_mode_next"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tv_mode_label"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tv_mode_dots"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</LinearLayout>
