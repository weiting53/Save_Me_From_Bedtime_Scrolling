<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 星空流星背景動畫 -->
    <com.sleepguardian.StarfieldView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 主要內容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbarThumbVertical="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="28dp"
            android:paddingTop="72dp"
            android:paddingBottom="48dp">

            <!-- ════ 夜燈 + 睡覺時間 ════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <!-- 夜燈暖光 -->
                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/lamp_glow"
                    android:contentDescription="夜燈"
                    android:layout_marginEnd="12dp" />

                <!-- 右欄：睡覺時間 + 起床時間 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 睡覺時間標籤 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="預 計 睡 覺 時 間"
                        android:textColor="#3d4e62"
                        android:textSize="8.5sp"
                        android:letterSpacing="0.22" />

                    <!-- 睡覺時間（大字，可點擊） -->
                    <LinearLayout
                        android:id="@+id/time_sleep_area"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingVertical="2dp">

                        <TextView
                            android:id="@+id/tv_sleep_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="23:00"
                            android:textColor="#ddd9cc"
                            android:textSize="58sp"
                            android:fontFamily="sans-serif-thin"
                            android:letterSpacing="-0.04"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✎"
                            android:textColor="#2e3e52"
                            android:textSize="14sp"
                            android:paddingStart="6dp"
                            android:paddingBottom="8dp" />
                    </LinearLayout>

                    <!-- 起床時間（小字，可點擊） -->
                    <LinearLayout
                        android:id="@+id/time_wake_area"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="自動關閉  "
                            android:textColor="#2b3a4e"
                            android:textSize="9sp"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tv_wake_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="05:00"
                            android:textColor="#556070"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-light"
                            android:letterSpacing="-0.02" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" ✎"
                            android:textColor="#1e2e3e"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ════ 勸睡模式選擇 Bar ════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="勸 睡 模 式"
                android:textColor="#3d4e62"
                android:textSize="8.5sp"
                android:letterSpacing="0.22"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/mode_bar_bg">

                <Button
                    android:id="@+id/btn_mode_prev"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:text="◀"
                    android:textColor="#c9a96e"
                    android:textSize="14sp"
                    android:backgroundTint="@android:color/transparent"
                    style="?attr/borderlessButtonStyle" />

                <TextView
                    android:id="@+id/tv_mode_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="組合包"
                    android:textColor="#c9a96e"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    android:fontFamily="sans-serif-light"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <Button
                    android:id="@+id/btn_mode_next"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:text="▶"
                    android:textColor="#c9a96e"
                    android:textSize="14sp"
                    android:backgroundTint="@android:color/transparent"
                    style="?attr/borderlessButtonStyle" />
            </LinearLayout>

            <!-- 模式位置指示點 -->
            <TextView
                android:id="@+id/tv_mode_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● ○ ○ ○"
                android:textColor="#c9a96e"
                android:textSize="6sp"
                android:letterSpacing="0.6"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <!-- ════ 每日開關 + ADB 提示 ════ -->
            <Switch
                android:id="@+id/sw_daily_schedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="每日自動開始"
                android:textColor="#3d4e62"
                android:textSize="11sp"
                android:thumbTint="#2e3d50"
                android:trackTint="#1a2535" />

            <TextView
                android:id="@+id/tv_adb_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="💡 灰階需一次性 ADB 授權（點我查看）"
                android:textColor="#3d4e62"
                android:textSize="9.5sp"
                android:alpha="0.55"
                android:letterSpacing="0.04"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- 裝飾分隔線 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#0d1825" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ✦  "
                    android:textColor="#182535"
                    android:textSize="10sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#0d1825" />
            </LinearLayout>

            <!-- ════ 狀態卡片 ════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:paddingVertical="20dp"
                android:paddingHorizontal="24dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tv_phase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="尚未啟動"
                    android:textColor="#c9a96e"
                    android:textSize="12sp"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="點「開始引導」讓引導在背景運行"
                    android:textColor="#3a4d60"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <!-- ════ 按鈕 ════ -->
            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="開  始  引  導"
                android:textSize="13sp"
                android:letterSpacing="0.18"
                android:textColor="#060a14"
                android:backgroundTint="#c9a96e"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="停  止  引  導"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textColor="#2e3d50"
                android:backgroundTint="#080f1e"
                android:strokeColor="#162030"
                android:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:enabled="false" />

            <!-- Demo 入口（低調） -->
            <TextView
                android:id="@+id/tv_demo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:padding="10dp"
                android:text="demo模式"
                android:textColor="#253040"
                android:textSize="9sp"
                android:alpha="0.26"
                android:letterSpacing="0.08"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
