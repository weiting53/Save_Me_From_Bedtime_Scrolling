<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── 星空流星背景動畫 ── -->
    <com.sleepguardian.StarfieldView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ── 主要內容 ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbarThumbVertical="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="28dp"
            android:paddingTop="68dp"
            android:paddingBottom="48dp">

            <!-- 月亮圖示 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☾"
                android:textColor="#c9a96e"
                android:textSize="24sp"
                android:layout_marginBottom="6dp" />

            <!-- App 名稱 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S L E E P  G U A R D I A N"
                android:textColor="#253040"
                android:textSize="8.5sp"
                android:letterSpacing="0.45"
                android:fontFamily="sans-serif-light"
                android:layout_marginBottom="52dp" />

            <!-- ════ 睡覺時間區 ════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="預 計 睡 覺 時 間"
                android:textColor="#3d4e62"
                android:textSize="10sp"
                android:letterSpacing="0.22"
                android:layout_marginBottom="0dp" />

            <!-- 大時間數字（點擊可修改） -->
            <LinearLayout
                android:id="@+id/time_sleep_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/tv_sleep_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="23:00"
                    android:textColor="#ddd9cc"
                    android:textSize="82sp"
                    android:fontFamily="sans-serif-thin"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎"
                    android:textColor="#2e3e52"
                    android:textSize="20sp"
                    android:paddingStart="6dp"
                    android:paddingBottom="10dp" />
            </LinearLayout>

            <!-- ── 裝飾分隔線 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#0d1825" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ✦  "
                    android:textColor="#182535"
                    android:textSize="10sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#0d1825" />
            </LinearLayout>

            <!-- ════ 起床時間區 ════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="早 上 自 動 關 閉"
                android:textColor="#2e3d50"
                android:textSize="10sp"
                android:letterSpacing="0.22"
                android:layout_marginBottom="0dp" />

            <!-- 起床時間數字（較小，次要） -->
            <LinearLayout
                android:id="@+id/time_wake_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/tv_wake_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="05:00"
                    android:textColor="#6a7a90"
                    android:textSize="54sp"
                    android:fontFamily="sans-serif-thin"
                    android:letterSpacing="-0.03"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎"
                    android:textColor="#222e3e"
                    android:textSize="14sp"
                    android:paddingStart="5dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- ════ 狀態卡片 ════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:paddingVertical="20dp"
                android:paddingHorizontal="24dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="28dp">

                <TextView
                    android:id="@+id/tv_phase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="尚未啟動"
                    android:textColor="#c9a96e"
                    android:textSize="12sp"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="點「開始引導」讓引導在背景運行"
                    android:textColor="#3a4d60"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <!-- ════ 按鈕 ════ -->
            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="開  始  引  導"
                android:textSize="13sp"
                android:letterSpacing="0.18"
                android:textColor="#060a14"
                android:backgroundTint="#c9a96e"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="停  止  引  導"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textColor="#2e3d50"
                android:backgroundTint="#080f1e"
                android:strokeColor="#162030"
                android:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:enabled="false" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
